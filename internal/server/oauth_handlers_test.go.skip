// newTestDatabase creates a test database for OAuth state manager tests
func newTestDatabaseOAuth(t *testing.T) *database.Database {
	// Reset singleton instance to avoid conflicts
	database.ResetInstance()

	tempDir, err := os.MkdirTemp("", "oauth_test_*")
	if err != nil {
		t.Fatalf("Failed to create temp dir: %v", err)
	}
	t.Cleanup(func() {
		os.RemoveAll(tempDir)
		database.ResetInstance()
	})

	db, err := database.Initialize(tempDir)
	if err != nil {
		t.Fatalf("Failed to initialize test database: %v", err)
	}
	t.Cleanup(func() { db.Close() })

	return db
}

// TestOAuthLoginHandler tests the OAuth login handler
func TestOAuthLoginHandler(t *testing.T) {
	app := fiber.New()
	db := newTestDatabaseOAuth(t)
	server := NewServer(".", 3333)
	server.config = &Config{
		Auth: AuthSettings{
			OAuth: &OAuthSettings{
				Enabled: true,
				Providers: map[string]*OAuthProvider{
					"google": {
						Enabled:     true,
						ClientID:    "test-client-id",
						ClientSecret: "test-secret",
						RedirectURI: "http://localhost:3333/api/oauth/callback/google",
						AuthURL:     "https://accounts.google.com/o/oauth2/v2/auth",
						TokenURL:    "https://oauth2.googleapis.com/token",
						UserInfoURL: "https://openidconnect.googleapis.com/v1/userinfo",
						Scopes:      []string{"openid", "email", "profile"},
					},
				},
			},
		},
	}
	server.oauthStateManager = NewOAuthStateManager(db)

	app.Get("/api/auth/oauth/authorize", server.handleOAuthLogin)

	tests := []struct {
		name           string
		provider       string
		expectedStatus int
		expectedBody   string
	}{
		{
			name:           "valid google oauth",
			provider:       "google",
			expectedStatus: http.StatusOK,
			expectedBody:   "auth_url",
		},
		{
			name:           "missing provider",
			provider:       "",
			expectedStatus: http.StatusBadRequest,
			expectedBody:   "provider is required",
		},
		{
			name:           "disabled provider",
			provider:       "github",
			expectedStatus: http.StatusBadRequest,
			expectedBody:   "not enabled",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			req := httptest.NewRequest("GET", "/api/auth/oauth/authorize?provider="+tt.provider, nil)
			resp, _ := app.Test(req)

			if resp.StatusCode != tt.expectedStatus {
				t.Errorf("Status = %d, expected %d", resp.StatusCode, tt.expectedStatus)
			}
		})
	}
}

// TestOAuthStateTokenUniqueness tests that state tokens are unique
func TestOAuthStateTokenUniqueness(t *testing.T) {
	db := newTestDatabaseOAuth(t)
	manager := NewOAuthStateManager(db)

	states := make(map[string]bool)
	count := 100

	for i := 0; i < count; i++ {
		state, err := manager.GenerateState("google")
		if err != nil {
			t.Fatalf("GenerateState failed: %v", err)
		}

		if states[state] {
			t.Errorf("Duplicate state token generated (iteration %d)", i)
		}
		states[state] = true
	}

	if len(states) != count {
		t.Errorf("Generated %d unique states out of %d attempts", len(states), count)
	}
}

// TestOAuthCallbackWithInvalidState tests OAuth callback with invalid state
func TestOAuthCallbackWithInvalidState(t *testing.T) {
	app := fiber.New()
	db := newTestDatabaseOAuth(t)
	server := NewServer(".", 3333)
	server.config = &Config{
		Auth: AuthSettings{
			OAuth: &OAuthSettings{
				Enabled: true,
				Providers: map[string]*OAuthProvider{
					"google": {
						Enabled: true,
					},
				},
			},
		},
	}
	server.oauthStateManager = NewOAuthStateManager(db)

	app.Post("/api/auth/oauth/callback", server.handleOAuthCallback)

	// Test with invalid state
	req := httptest.NewRequest("POST", "/api/auth/oauth/callback",
		strings.NewReader(`{"code":"test","state":"invalid-state"}`))
	req.Header.Set("Content-Type", "application/json")
	resp, _ := app.Test(req)

	// ValidateState should return an error, which gets status 401 (Unauthorized)
	if resp.StatusCode != http.StatusUnauthorized && resp.StatusCode != http.StatusBadRequest {
		t.Errorf("Status = %d, expected %d or %d", resp.StatusCode, http.StatusUnauthorized, http.StatusBadRequest)
	}
}

// TestOAuthCallbackWithErrorResponse tests OAuth callback with provider error
func TestOAuthCallbackWithErrorResponse(t *testing.T) {
	app := fiber.New()
	db := newTestDatabaseOAuth(t)
	server := NewServer(".", 3333)
	server.config = &Config{
		Auth: AuthSettings{
			OAuth: &OAuthSettings{
				Enabled: true,
			},
		},
	}
	server.oauthStateManager = NewOAuthStateManager(db)

	app.Get("/api/auth/oauth/callback/google", server.handleOAuthCallback)

	// Test with error from provider
	req := httptest.NewRequest("GET", "/api/auth/oauth/callback/google?error=access_denied&error_description=User+denied+access", nil)
	resp, _ := app.Test(req)

	if resp.StatusCode != http.StatusUnauthorized {
		t.Errorf("Status = %d, expected %d (Unauthorized)", resp.StatusCode, http.StatusUnauthorized)
	}
}

// TestGenerateUsernameFromEmail tests username generation
func TestGenerateUsernameFromEmail(t *testing.T) {
	server := &Server{}

	tests := []struct {
		email    string
		expected string
	}{
		{"john.doe@example.com", "john_doe"},
		{"user+tag@example.com", "user_tag"},
		{"simple@example.com", "simple"},
		{"first-last@example.com", "first_last"},
		{"user123@example.com", "user123"},
	}

	for _, tt := range tests {
		result := server.generateUsernameFromEmail(tt.email)
		if result != tt.expected {
			t.Errorf("generateUsernameFromEmail(%q) = %q, expected %q", tt.email, result, tt.expected)
		}
	}
}

// TestOAuthStateExpiry tests that state tokens expire after 15 minutes
func TestOAuthStateExpiry(t *testing.T) {
	db := newTestDatabaseOAuth(t)
	manager := NewOAuthStateManager(db)

	state, err := manager.GenerateState("google")
	if err != nil {
		t.Fatalf("GenerateState failed: %v", err)
	}

	// State should be valid immediately
	_, _, err = manager.ValidateState(state)
	if err != nil {
		t.Errorf("Fresh state should be valid, got error: %v", err)
	}

	// Generate new state (after consuming the first)
	state, err = manager.GenerateState("google")
	if err != nil {
		t.Fatalf("GenerateState failed: %v", err)
	}

	// Manually expire the state in database
	query := `UPDATE oauth_state_tokens SET expires_at = ? WHERE state = ?`
	_, err = db.GetDB().Exec(query, time.Now().Add(-1*time.Minute), state)
	if err != nil {
		t.Fatalf("Failed to expire state in database: %v", err)
	}

	// Expired state should be invalid
	_, _, err = manager.ValidateState(state)
	if err == nil {
		t.Errorf("Expired state should be invalid, got nil error")
	}
}

// TestOAuthStateNonceGeneration tests nonce generation
func TestOAuthStateNonceGeneration(t *testing.T) {
	db := newTestDatabaseOAuth(t)
	manager := NewOAuthStateManager(db)

	state1, err := manager.GenerateState("google")
	if err != nil {
		t.Fatalf("GenerateState failed: %v", err)
	}

	// Query nonce from database
	var nonce1 string
	err = db.GetDB().QueryRow(`SELECT nonce FROM oauth_state_tokens WHERE state = ?`, state1).Scan(&nonce1)
	if err != nil {
		t.Fatalf("Failed to query nonce: %v", err)
	}

	state2, err := manager.GenerateState("google")
	if err != nil {
		t.Fatalf("GenerateState failed: %v", err)
	}

	// Query nonce from database
	var nonce2 string
	err = db.GetDB().QueryRow(`SELECT nonce FROM oauth_state_tokens WHERE state = ?`, state2).Scan(&nonce2)
	if err != nil {
		t.Fatalf("Failed to query nonce: %v", err)
	}

	// Nonces should be different
	if nonce1 == nonce2 {
		t.Errorf("Generated nonces are identical (should be random)")
	}

	// Nonces should not be empty
	if nonce1 == "" || nonce2 == "" {
		t.Errorf("Generated nonce is empty")
	}
}

// TestOAuthProviderConfiguration tests OAuth provider configuration
func TestOAuthProviderConfiguration(t *testing.T) {
	provider := StandardOAuthProviders["google"]

	if provider == nil {
		t.Fatalf("Google OAuth provider not found in standard providers")
	}

	// Verify required fields
	if provider.ClientID == "" && provider.Enabled {
		t.Errorf("ClientID should be configured before enabling")
	}

	if provider.ClientSecret == "" && provider.Enabled {
		t.Errorf("ClientSecret should be configured before enabling")
	}

	if provider.AuthURL == "" {
		t.Errorf("AuthURL should be set")
	}

	if provider.TokenURL == "" {
		t.Errorf("TokenURL should be set")
	}

	if provider.UserInfoURL == "" {
		t.Errorf("UserInfoURL should be set")
	}

	if len(provider.Scopes) == 0 {
		t.Errorf("At least one scope should be configured")
	}
}

// TestOAuthStateProviderStorage tests that provider is stored with state
func TestOAuthStateProviderStorage(t *testing.T) {
	db := newTestDatabaseOAuth(t)
	manager := NewOAuthStateManager(db)

	providers := []string{"google", "github", "microsoft"}

	for _, provider := range providers {
		state, err := manager.GenerateState(provider)
		if err != nil {
			t.Fatalf("GenerateState failed for %s: %v", provider, err)
		}

		// Query provider from database
		var storedProvider string
		err = db.GetDB().QueryRow(`SELECT provider FROM oauth_state_tokens WHERE state = ?`, state).Scan(&storedProvider)
		if err != nil {
			t.Errorf("State not found for provider %s", provider)
			continue
		}

		if storedProvider != provider {
			t.Errorf("Provider = %q, expected %q", storedProvider, provider)
		}
	}
}

// ========== NEW: Tests for OAuth + MFA Security Fix ==========

// TestOAuthCallbackWithMFAEnabled tests that OAuth callback requires MFA for MFA-enabled users
func TestOAuthCallbackWithMFAEnabled(t *testing.T) {
	db := newTestDatabaseOAuth(t)
	server := NewServer(".", 3333)
	server.db = db
	server.userStore = &UserStore{
		users:    make(map[string]*User),
		sessions: make(map[string]*Session),
		db:       db,
	}
	server.config = &Config{
		Auth: AuthSettings{
			OAuth: &OAuthSettings{
				Enabled: true,
				Providers: map[string]*OAuthProvider{
					"google": {
						Enabled:     true,
						ClientID:    "test-client-id",
						RedirectURI: "http://localhost:3333/api/oauth/callback/google",
						Scopes:      []string{"openid", "email"},
					},
				},
			},
		},
	}
	server.oauthStateManager = NewOAuthStateManager(db)

	// Create test user
	server.userStore.CreateUser("testuser", "password", false)
	server.userStore.users["testuser"].Email = "test@example.com"

	// Enable MFA for the user
	repo := database.NewRepository(db)
	mfaConfig := &database.MFAConfig{
		Username:  "testuser",
		IsEnabled: true,
		CreatedAt: time.Now(),
		UpdatedAt: time.Now(),
	}
	if err := repo.SaveMFAConfig(mfaConfig); err != nil {
		t.Fatalf("Failed to save MFA config: %v", err)
	}

	// For this test, we verify that the response format includes MFA fields
	// In a real scenario, we would mock exchangeCodeForToken and fetchUserInfo
	t.Run("OAuth callback should return mfa_required for MFA-enabled user", func(t *testing.T) {
		// This is a structural test to ensure the code path exists
		// Full integration testing would require mocking OAuth provider responses
		if server.config.Auth.OAuth.Providers["google"].Enabled {
			t.Log("✓ OAuth provider is enabled")
		}

		// Verify database has MFA config
		savedConfig, err := repo.GetMFAConfig("testuser")
		if err != nil || savedConfig == nil || !savedConfig.IsEnabled {
			t.Error("MFA config not properly saved")
		} else {
			t.Log("✓ MFA config is enabled for test user")
		}
	})
}

// TestOAuthCallbackWithMFADisabled tests that OAuth callback works normally for non-MFA users
func TestOAuthCallbackWithMFADisabled(t *testing.T) {
	db := newTestDatabaseOAuth(t)
	server := NewServer(".", 3333)
	server.db = db
	server.userStore = &UserStore{
		users:    make(map[string]*User),
		sessions: make(map[string]*Session),
		db:       db,
	}

	// Create test user without MFA
	server.userStore.CreateUser("nonmfauser", "password", false)
	server.userStore.users["nonmfauser"].Email = "nonmfa@example.com"

	// Verify no MFA config exists
	repo := database.NewRepository(db)
	mfaConfig, err := repo.GetMFAConfig("nonmfauser")
	if err == nil && mfaConfig == nil {
		t.Log("✓ No MFA config for non-MFA user (as expected)")
	}
}

// TestGenerateTemporaryTokenUniqueness tests that temporary tokens are unique
func TestGenerateTemporaryTokenUniqueness(t *testing.T) {
	tokens := make(map[string]bool)
	count := 50

	for i := 0; i < count; i++ {
		token := GenerateTemporaryToken()
		if tokens[token] {
			t.Errorf("Duplicate temporary token generated (iteration %d)", i)
		}
		tokens[token] = true
	}

	if len(tokens) != count {
		t.Errorf("Generated %d unique tokens out of %d attempts", len(tokens), count)
	} else {
		t.Log("✓ All temporary tokens are unique")
	}
}

// TestOAuthMFAResponseStructure tests that the login response has MFA fields
func TestOAuthMFAResponseStructure(t *testing.T) {
	// Verify LoginResponse struct has MFA fields
	lr := LoginResponse{
		Username:         "test",
		MFARequired:      true,
		TemporaryToken:   "temp123",
		TemporaryExpires: time.Now().Add(5 * time.Minute),
	}

	if lr.Username != "test" {
		t.Error("Username field missing")
	}
	if !lr.MFARequired {
		t.Error("MFARequired field should be true")
	}
	if lr.TemporaryToken != "temp123" {
		t.Error("TemporaryToken field missing")
	}
	if lr.TemporaryExpires.IsZero() {
		t.Error("TemporaryExpires field missing")
	}

	t.Log("✓ LoginResponse structure has all required MFA fields")
}

// TestMFATemporaryTokenExpiration tests that temporary tokens have proper expiration
func TestMFATemporaryTokenExpiration(t *testing.T) {
	expiresAt := CalculateTokenExpiration(300) // 5 minutes
	now := time.Now()

	// Token should expire in approximately 5 minutes
	duration := expiresAt.Sub(now)
	expectedDuration := 5 * time.Minute

	// Allow for small time difference (±10 seconds)
	if duration < expectedDuration-10*time.Second || duration > expectedDuration+10*time.Second {
		t.Errorf("Token expiration time incorrect: %v (expected ~%v)", duration, expectedDuration)
	} else {
		t.Log("✓ Temporary token has correct 5-minute expiration")
	}
}

